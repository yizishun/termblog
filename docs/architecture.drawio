                <mxCell id="web" value="termblog-web 进程 (axum, 0.0.0.0:8080) [降权 www]" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="330" y="-90" width="370" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="router" value="Router&#xa;GET /ws → handle()&#xa;其余 → ServeDir(frontend/dist)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="web" vertex="1">
                    <mxGeometry x="20" y="46" width="300" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="websess" value="会话持有表 WebSession (token → 句柄)&#xa;· 60s 宽限: 刷新不断会话&#xa;· 转发 task: scrollback 128KiB + attach 回放&#xa;(先订阅再回放, 不重不漏)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="web" vertex="1">
                    <mxGeometry x="20" y="112" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="handshake" value="handle()&#xa;首帧须为 Open{cols,rows}&#xa;attach 优先 → 否则 create()&#xa;→ Opened → 上行/下行泵" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="web" vertex="1">
                    <mxGeometry x="20" y="212" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="wsclient" value="SessionClient (termblog-core, 每会话一条 socket 连接)&#xa;open(): 连 socket → 发 Open 帧 → 读 Opened/Closed&#xa;(配额拒绝在此报错)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="web" vertex="1">
                    <mxGeometry x="20" y="304" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="wpump" value="客户端pump task (每会话一个, open 内 spawn)&#xa;键入/Resize → 帧写 socket;&#xa;socket 帧 → 广播输出&#xa;断开: drop 输出端 → 会话交还" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="web">
                    <mxGeometry x="20" y="370" width="300" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="sshl" value="termblog-ssh 进程 (russh, 0.0.0.0:2222) [降权 www]" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="750" y="-90" width="360" height="374" as="geometry"/>
                </mxCell>
                <mxCell id="rserver" value="russh Server&#xa;auth_none / auth_password:&#xa;用户名 == blog 即免密接受" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="sshl" vertex="1">
                    <mxGeometry x="20" y="46" width="280" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="rhandler" value="SshHandler&#xa;pty_request → 记 winsize&#xa;shell_request → client.open()&#xa;window_change → Resize&#xa;exec / subsystem 一律拒绝" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="sshl" vertex="1">
                    <mxGeometry x="20" y="120" width="280" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="sshclient" value="SessionClient (termblog-core)&#xa;open(): 连 socket → 发 Open 帧 → 读 Opened/Closed&#xa;(客户端泵同 web: 键入/Resize → 帧; 帧 → 输出广播)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" parent="sshl" vertex="1">
                    <mxGeometry x="20" y="224" width="280" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sdown" value="下行pump task (russh 侧)&#xa;输出 → channel data&#xa;会话终结 → exit_status + close" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sshl">
                    <mxGeometry x="20" y="296" width="280" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="boundary" value="权限边界 —— /var/run/termblog.sock · SOCK_SEQPACKET(一帧 = 一条消息, 无粘包) · 0660 root:www" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="360" y="530" width="720" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="boundline" value="" style="endArrow=none;dashed=1;strokeWidth=1;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="40" y="555" width="1040" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="jaild" value="jaild 进程 [root] —— 整个系统唯一携带 root 的进程" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="360" y="620" width="720" height="474" as="geometry"/>
                </mxCell>
                <mxCell id="jlistener" value="LinkListener (SOCK_SEQPACKET)&#xa;启动: 先 bind socket 再 sweep 残留 + 补 devfs 规则集 4&#xa;(重启窗口内连接在 backlog 排队, 不被拒) → chmod 0660 / chown root:www → accept → handle_conn" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d6b656;fontSize=12;" parent="jaild" vertex="1">
                    <mxGeometry x="20" y="46" width="680" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="jconn" value="handle_conn (每连接一个 task)&#xa;15s 握手: 首帧必须 Open (attach_token 已废弃, 忽略) → SessionManager::create, 配额拒绝回 Closed → Opened&#xa;单 task 双 select: 上行 Data→input / Resize→control; 下行 输出→帧 / 终结→Closed&#xa;socket 断开 = drop 句柄 = 会话立即回收 (无宽限期)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d6b656;fontSize=12;" parent="jaild" vertex="1">
                    <mxGeometry x="20" y="122" width="680" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="jmgr" value="SessionManager::create(peer_ip 由网关填入, 客户端不可信)&#xa;配额: 全局 ≤64 / 每 IP ≤3 (同一把锁检查+占位, 不超发) → 起会话 pump task&#xa;JailBackend (create 内调用, blocking 线程):&#xa;① zfs clone 只读模板(设 quota=4M, fail-closed)  ② mountpoint + devfs(规则集 4)  ③ jail -c(无网络, allow.* 全关, persist)&#xa;④ rctl×5 (fail-closed: 挂不上就拒绝开会话)  ⑤ 解析 jail 内 passwd 得 guest&#xa;⑥ openpty + fork; 子进程: setsid → ctty → jail_attach → setuid(guest) → chdir(家目录) → exec zsh" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="jaild">
                    <mxGeometry x="20" y="222" width="680" height="136" as="geometry"/>
                </mxCell>
                <mxCell id="jpump" value="会话 pump task (每会话一个, 独占 PTY)&#xa;select!{ 键入→write(master) · Resize→TIOCSWINSZ+SIGWINCH · master 可读→read→broadcast }&#xa;回收: SIGHUP 进程组 → reap(5s→SIGKILL) → cleanup(销 jail) → 移出会话表 (每环落日志)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d6b656;fontSize=12;" parent="jaild" vertex="1">
                    <mxGeometry x="20" y="368" width="680" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="kern" value="操作系统内核 / 子进程" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="-80" y="570" width="280" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="master" value="PTY master&#xa;(非阻塞 fd)&#xa;ShellChild.master" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#9673a6;fontSize=12;" parent="kern" vertex="1">
                    <mxGeometry x="20" y="70" width="115" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="slave" value="PTY slave&#xa;/dev/ttysN" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#9673a6;fontSize=12;" parent="kern" vertex="1">
                    <mxGeometry x="150" y="70" width="110" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="jailbox" value="jail s-&lt;sid&gt; (persist, 无网络)&#xa;· 根: zfs clone 自只读模板 @release&#xa;· devfs (规则集 4: 只露无害设备)&#xa;· allow.* 全关&#xa;· rctl: mem 128M / vmem 512M / proc 32 / files 256 / pcpu 25%&#xa;· zfs quota=4M: 写满报 Disc quota exceeded&#xa;· 销毁: umount devfs → jail -r → zfs destroy (幂等)" style="rounded=1;whiteSpace=wrap;fill=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;" parent="kern" vertex="1">
                    <mxGeometry x="20" y="200" width="240" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="zsh" value="zsh -l (uid=guest)&#xa;fd 0/1/2 = PTY slave&#xa;HOME=/home/guest, cwd=家目录" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#b85450;fontSize=12;" parent="kern" vertex="1">
                    <mxGeometry x="50" y="310" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="HTTP GET / → index.html + js (一次性)&#xa;WebSocket: 一条消息 = 一个 proto 帧&#xa;↑ Open/Data(键入)/Resize&#xa;↓ Opened/Data(输出)/Closed" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="tsproto" target="router" edge="1">
                    <mxGeometry x="-0.0189" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e2" value="每会话一条 socket 连接 (SEQPACKET)&#xa;Open{cols,rows,attach_token?,peer_ip} →&#xa;Data / Resize →&#xa;← Opened / Data / Closed" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" parent="1" source="wsclient" target="jlistener" edge="1">
                    <mxGeometry x="-0.0323" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e3" value="每会话一条 socket 连接&#xa;peer_ip 由网关从 TCP 握手填入" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" parent="1" source="sshclient" target="jlistener" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="read / write(键入)&#xa;TIOCSWINSZ" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" parent="1" source="jpump" target="master" edge="1">
                    <mxGeometry x="-0.6917" y="-11" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="建 (create 内): zfs clone → jail -c → rctl×5&#xa;销 (泵回收时): jail -r → zfs destroy" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" parent="1" source="jmgr" target="jailbox" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="fd 0/1/2" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" parent="1" source="slave" target="zsh" edge="1">
                    <mxGeometry x="-0.5918" y="5" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="legend" value="颜色: 蓝=浏览器  绿=接入层(www)  黄=jaild(root)  紫=内核/jail  红=权限边界/危险资源 · 新增: 橙=rc 开机链  青=daemon(8) 进程看守  灰=日志与轮转  白虚线=部署脚本" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="570" width="680" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rcgroup" value="开机启动链 (rc 框架) [root]" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="620" width="330" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="rc_init" value="init(8) (PID 1)&#xa;最后一步: 执行 /etc/rc" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="46" width="290" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="rc_rc" value="/etc/rc —— 系统启动主脚本&#xa;只拉起 rcvar=YES 的服务" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="98" width="290" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="rc_rcorder" value="rcorder(8) 按依赖排序执行&#xa;PROVIDE / REQUIRE / BEFORE / KEYWORD&#xa;→ 依赖链: LOGIN,zfs → jaild → termblog" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="150" width="290" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="rc_conf" value="/etc/rc.conf (sysrc 写入)&#xa;jaild_enable=YES&#xa;termblog_enable=YES&#xa;(缺失 = 开机不拉起)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="210" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="rc_jaild" value="/usr/local/etc/rc.d/jaild [root]&#xa;PROVIDE jaild · REQUIRE LOGIN zfs&#xa;BEFORE termblog · KEYWORD shutdown&#xa;command: /usr/sbin/daemon -H&#xa;  -o /var/log/jaild.log&#xa;  -p /var/run/jaild.pid (子进程)&#xa;  -P /var/run/jaild-super.pid (监督进程)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="276" width="290" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="rc_tb" value="/usr/local/etc/rc.d/termblog [www]&#xa;REQUIRE LOGIN jaild · KEYWORD shutdown&#xa;start_cmd: daemon -H -u www ×2&#xa;  (termblog-web + termblog-ssh)&#xa;stop_cmd: 按 pidfile kill" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#d79b00;fontSize=12;" parent="rcgroup" vertex="1">
                    <mxGeometry x="20" y="398" width="290" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="dgroup" value="daemon(8) 进程看守 (FreeBSD 基础系统)" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#d0ece7;strokeColor=#0e8088;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="620" width="310" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="d_jaild" value="daemon [root] 看守 jaild&#xa;-H -o /var/log/jaild.log&#xa;-p /var/run/jaild.pid&#xa;-P /var/run/jaild-super.pid&#xa;→ /usr/local/sbin/jaild" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#0e8088;fontSize=12;" parent="dgroup" vertex="1">
                    <mxGeometry x="20" y="46" width="270" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="d_web" value="daemon -u www 看守 web&#xa;-H -o /var/log/termblog-web.log&#xa;-p /var/run/termblog-web.pid&#xa;-P /var/run/termblog-web-super.pid&#xa;→ /usr/local/sbin/termblog-web" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#0e8088;fontSize=12;" parent="dgroup" vertex="1">
                    <mxGeometry x="20" y="132" width="270" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="d_ssh" value="daemon -u www 看守 ssh&#xa;-H -o /var/log/termblog-ssh.log&#xa;-p /var/run/termblog-ssh.pid&#xa;-P /var/run/termblog-ssh-super.pid&#xa;→ /usr/local/sbin/termblog-ssh" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#0e8088;fontSize=12;" parent="dgroup" vertex="1">
                    <mxGeometry x="20" y="218" width="270" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="loggroup" value="日志与轮转 (cron + newsyslog)" style="swimlane;startSize=32;fontSize=15;fontStyle=1;fill=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="950" width="310" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="log_files" value="日志文件 (进程只写 stderr, daemon 落盘)&#xa;/var/log/jaild.log&#xa;/var/log/termblog-web.log&#xa;/var/log/termblog-ssh.log" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#666666;fontSize=12;" parent="loggroup" vertex="1">
                    <mxGeometry x="20" y="46" width="270" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="log_newsys" value="newsyslog(8) (系统自带轮转器)&#xa;读 /etc/newsyslog.conf →&#xa;  &lt;include&gt; /usr/local/etc/&#xa;  newsyslog.conf.d/termblog.conf&#xa;规则: &gt;500KB 轮转 · 留 7 份归档&#xa;(zroot 有 lz4, 归档不重复压缩)" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#666666;fontSize=12;" parent="loggroup" vertex="1">
                    <mxGeometry x="20" y="140" width="270" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="log_cron" value="/etc/crontab (cron, 每小时整点)&#xa;0 * * * * root newsyslog" style="rounded=1;whiteSpace=wrap;fill=#ffffff;strokeColor=#666666;fontSize=12;" parent="loggroup" vertex="1">
                    <mxGeometry x="20" y="240" width="270" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="deploy" value="scripts/deploy-root.sh [root, 一键部署 + 滚动重启]&#xa;install 二进制 → /usr/local/sbin · install rc 脚本 → /usr/local/etc/rc.d/&#xa;install 轮转规则 → /usr/local/etc/newsyslog.conf.d/ · sysrc *_enable=YES → /etc/rc.conf&#xa;部署最后一步: kill 旧 pid → 由 daemon 起新二进制(与 rc 同款参数)" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="1310" width="680" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="rc_init" target="rc_rc" edge="1">
