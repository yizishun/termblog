                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="write(键入) / TIOCSWINSZ&#xa;read(输出)" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" parent="1" source="pump" target="master" edge="1">
