#!/bin/sh

# PROVIDE: jaild
# REQUIRE: LOGIN zfs commentd termblog_statd
# BEFORE: termblog
# KEYWORD: shutdown

# jaild [root]: termblog 特权守护进程(每访客一个 ephemeral jail)。
# 监听 /var/run/termblog.sock(0660 root:www), 必须跑在 root。

. /etc/rc.subr

name="jaild"
rcvar="jaild_enable"

command="/usr/sbin/daemon"
# -H: 收到 SIGHUP 时 close+reopen 输出文件(newsyslog 轮转日志用)
# -p: 子进程 pid(rc stop 用)  -P: 监督进程 pid(newsyslog 发 SIGHUP 的目标)
command_args="-H -p /var/run/jaild.pid -P /var/run/jaild-super.pid -o /var/log/jaild.log /usr/local/sbin/jaild"
pidfile="/var/run/jaild.pid"

load_rc_config "$name"
: "${jaild_enable:=NO}"

run_rc_command "$1"
