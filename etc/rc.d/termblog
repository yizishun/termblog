#!/bin/sh

# PROVIDE: termblog
# REQUIRE: LOGIN jaild termblog_statd
# KEYWORD: shutdown

# termblog 接入层(降权 www): 同时拉起 termblog-web(axum) 与
# termblog-ssh(russh), 两者都经 /var/run/termblog.sock 触达 jaild。
# 权限分离: 解析不可信网络输入的两个进程绝不携带 root。

. /etc/rc.subr

name="termblog"
rcvar="termblog_enable"

: "${termblog_enable:=NO}"
: "${termblog_user:=www}"

start_cmd="termblog_start"
stop_cmd="termblog_stop"

termblog_start()
{
    echo "Starting termblog (web + ssh) as ${termblog_user}."
    # 降权用户需要写的目录与日志
    mkdir -p /var/db/termblog /var/log
    chown "$termblog_user" /var/db/termblog
    install -d -m 700 -o "$termblog_user" -g "$termblog_user" /var/db/termblog/acme
    touch /var/log/termblog-web.log /var/log/termblog-ssh.log
    chown "$termblog_user" /var/log/termblog-web.log /var/log/termblog-ssh.log

    # -H/-P 同上: 配合 newsyslog 轮转(SIGHUP -> daemon 重开输出文件)
    /usr/sbin/daemon -H -u "$termblog_user" -p /var/run/termblog-web.pid \
        -P /var/run/termblog-web-super.pid -o /var/log/termblog-web.log \
        /usr/local/sbin/termblog-web
    /usr/sbin/daemon -H -u "$termblog_user" -p /var/run/termblog-ssh.pid \
        -P /var/run/termblog-ssh-super.pid -o /var/log/termblog-ssh.log \
        /usr/local/sbin/termblog-ssh
}

termblog_stop()
{
    for p in /var/run/termblog-web.pid /var/run/termblog-ssh.pid; do
        if [ -f "$p" ]; then
            pid=$(cat "$p")
            if kill "$pid" 2>/dev/null; then
                echo "Stopped ${p} (pid ${pid})."
            fi
            rm -f "$p"
        fi
    done
}

load_rc_config "$name"
run_rc_command "$1"
