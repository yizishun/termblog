@@ -0,0 +1,67 @@
+#!/bin/sh
+# blog —— 文章阅读入口(termblog M5)。像 cat 一样读 markdown 文件,
+# 顺手把浏览器地址栏同步到该文对应的镜像 URL。
+#   blog                列出文章(~/blog/.rendered/.index)
+#   blog <文件.md>      读一篇 markdown: 相对/绝对路径均可, 任意目录层级;
+#                       文件在 ~/blog/blog/ 下时同步地址栏 /blog/<slug>/,
+#                       退出分页器后复位到 /。交互终端用 less -RX 分页
+#                       (无备用屏, 不闪屏), 非交互管道直接 cat。
+# 模板构建时由 build-template.sh 安装到 /usr/local/bin(0555)。
+
+set -eu
+R="$HOME/blog"
+
+case "${1:-}" in
+    "")
+        if [ -f "$R/.rendered/.index" ]; then
+            cat "$R/.rendered/.index"
+        else
+            echo "暂无文章(模板里没有 .rendered/.index, 重建模板试试)"
+        fi
+        ;;
+    *)
+        # 解析文件: 先按原样(相对 cwd / 绝对), 再相对 ~/blog
+        file=""
+        for cand in "$1" "$R/$1"; do
+            if [ -f "$cand" ]; then
+                file=$cand
+                break
+            fi
+        done
+        if [ -z "$file" ]; then
+            echo "blog: 没有这个文件: $1 (敲 blog 看列表)" >&2
+            exit 1
+        fi
+        # 规范化成绝对路径(相对 cwd 的补 $PWD), 便于按 ~/blog/blog/ 前缀算 slug
+        case "$file" in
+            /*) ;;
+            *) file="$PWD/$file" ;;
+        esac
+
+        # 文件在 ~/blog/blog/ 下 → 算 slug 并同步地址栏(带尾斜杠 = canonical 形态)
+        # slug 白名单 [a-z0-9/-] 与内容编译器一致, 违规则不同步(仅阅读)
+        slug=""
+        case "$file" in
+            "$R/blog/"*.md)
+                slug=${file#"$R/blog/"}
+                slug=${slug%.md}
+                ;;
+        esac
+        case "$slug" in
+            *[!a-z0-9/-]*|""|*/|*//*) slug="" ;;
+        esac
+        if [ -n "$slug" ] && command -v webctl >/dev/null 2>&1; then
+            webctl url "/blog/$slug/"
+        fi
+        if [ -t 0 ]; then
+            # -X: 不进备用屏、退出后内容留在屏幕; -c: 每次绘制前先清屏重画,
+            #     文章永远画在干净画面上(不会叠在 attach 回放的旧画面上)
+            less -RXc "$file" || true
+        else
+            cat "$file"
+        fi
+        if [ -n "$slug" ] && command -v webctl >/dev/null 2>&1; then
+            webctl url /
+        fi
+        ;;
+esac
